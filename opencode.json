{
	"$schema": "https://opencode.ai/config.json",
	"model": "{env:OPENCODE_MODEL:-openai/gpt-4o}",
	"small_model": "{env:OPENCODE_SMALL_MODEL:-openai/gpt-4o-mini}",
	"default_agent": "coder",
	"shell": "/bin/bash",
	"share": "manual",
	"autoupdate": true,
	"snapshot": true,
	"lsp": true,
	"permission": "ask",
	"server": {
		"port": 4096,
		"hostname": "127.0.0.1",
		"mdns": false
	},
	"compaction": {
		"auto": true,
		"prune": true,
		"reserved": 10000
	},
	"tool_output": {
		"max_lines": 300,
		"max_bytes": 8192
	},
	"watcher": {
		"ignore": [
			"node_modules/**",
			".git/**",
			"dist/**",
			"build/**",
			".next/**",
			"*.db*"
		]
	},
	"plugin": [
		"opencode-vibeguard",
		"opencode-worktree",
		"opencode-scheduler",
		"opencode-background-agents"
	],
	"mcp": {
		"ast-lens": {
			"type": "local",
			"command": ["npx", "-y", "ast-lens-mcp", "."],
			"timeout": 60000
		},
		"playwright": {
			"type": "local",
			"command": ["npx", "-y", "@playwright/mcp"],
			"timeout": 120000
		},
		"github": {
			"type": "local",
			"command": ["npx", "-y", "@modelcontextprotocol/server-github"],
			"timeout": 60000,
			"environment": {
				"GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
			}
		}
	},
	"formatter": {
		"prettier": {
			"command": ["npx", "-y", "prettier", "--write", "$FILE"],
			"extensions": [
				".js",
				".jsx",
				".ts",
				".tsx",
				".html",
				".css",
				".md",
				".yaml",
				".yml",
				".graphql"
			]
		},
		"biome": {
			"command": ["npx", "-y", "@biomejs/biome", "format", "--write", "$FILE"],
			"extensions": [".json", ".jsonc"]
		}
	},
	"instructions": ["AGENTS.md"]
}
