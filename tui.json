{
	"$schema": "https://opencode.ai/tui.json",
	"theme": "catppuccin-mocha",
	"scroll_speed": 3,
	"scroll_acceleration": {
		"enabled": true
	},
	"diff_style": "auto",
	"mouse": true,
	"attention": {
		"enabled": true,
		"notifications": true,
		"sound": true,
		"volume": 0.4
	},
	"keybinds": {
		"command_list": "ctrl+p",
		"agent_picker": "ctrl+a",
		"model_picker": "ctrl+m",
		"session_list": "ctrl+s",
		"tool_details": "ctrl+d",
		"display_thinking": "ctrl+k"
	}
}
